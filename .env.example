# TEMPLATE ONLY. Run `uv run --locked grok-codex init` to generate private tokens.
# Do not use placeholder credentials or copy this template over an existing .env.
BRIDGE_STATE_DIR='~/.local/state/grok-codex'
BRIDGE_REPO_ROOTS='/path/to/projects'
BRIDGE_GROK_TOKEN=''
BRIDGE_HUMAN_TOKEN=''
BRIDGE_URL='http://127.0.0.1:48765'
BRIDGE_WEBHOOK_URL=''
BRIDGE_WEBHOOK_AUTH_HEADER=''
BRIDGE_WEBHOOK_SECRET=''
# Empty EVENTS disables notable deliveries; progress is separately opt-in.
BRIDGE_WEBHOOK_EVENTS='approval/required,approval/held,turn/completed,turn/failed,error,account/authentication_required,account/authentication_expired,process/lost,job/uncertain,session/detached,usage/limitReached,usage/limitNear'
BRIDGE_WEBHOOK_PROGRESS=0
# Used only when PROGRESS=1. Notable events bypass this interval.
BRIDGE_PROGRESS_INTERVAL=10
# Age is measured from source event time. Unresolved approvals are protected.
BRIDGE_WEBHOOK_MAX_EVENT_AGE_SEC=900
BRIDGE_USAGE_ALERT_PERCENT=90
