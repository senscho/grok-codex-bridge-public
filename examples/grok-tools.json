[
  {
    "type": "function",
    "function": {
      "name": "codex_start",
      "description": "Start. Adapter: POST /tools/codex_start with bearer token; mutations require a stable Idempotency-Key.",
      "parameters": {
        "properties": {
          "repo": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Repo"
          },
          "account": {
            "type": "string",
            "maxLength": 48,
            "minLength": 1,
            "title": "Account"
          },
          "prompt": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Prompt"
          },
          "options": {
            "properties": {
              "sandbox": {
                "type": "string",
                "enum": [
                  "workspace-write",
                  "read-only"
                ],
                "title": "Sandbox",
                "default": "workspace-write"
              },
              "approval_policy": {
                "type": "string",
                "enum": [
                  "on-request",
                  "untrusted"
                ],
                "title": "Approval Policy",
                "default": "on-request"
              },
              "model": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Model"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Options"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "repo",
          "account",
          "prompt"
        ],
        "title": "Start"
      }
    }
  },
