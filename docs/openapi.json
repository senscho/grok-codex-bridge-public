  "components": {
    "schemas": {
      "Approve": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Session Id"
          },
          "request_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Request Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "decline",
              "cancel"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "request_id",
          "decision"
        ],
        "title": "Approve"
      },
      "Control": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Session Id"
          },
          "owner": {
            "type": "string",
            "enum": [
              "human",
              "grok"
            ],
            "title": "Owner"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "owner"
        ],
        "title": "Control"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Logs": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Session Id"
          },
          "cursor": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cursor",
            "default": 0
          },
          "limit": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 100
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "Logs"
      },
      "Options": {
        "properties": {
          "sandbox": {
            "type": "string",
            "enum": [
              "workspace-write",
              "read-only"
            ],
            "title": "Sandbox",
            "default": "workspace-write"
          },
          "approval_policy": {
            "type": "string",
            "enum": [
              "on-request",
              "untrusted"
            ],
            "title": "Approval Policy",
            "default": "on-request"
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Options"
      },
      "Register": {
        "properties": {
          "account_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
            "title": "Account Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "account_id"
        ],
        "title": "Register"
      },
      "Replay": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Session Id"
          },
          "cursor": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cursor",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "Replay"
      },
      "Send": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Message"
          },
          "steer": {
            "type": "boolean",
            "title": "Steer",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "message"
        ],
        "title": "Send"
      },
      "Session": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "Session"
      },
      "Start": {
        "properties": {
